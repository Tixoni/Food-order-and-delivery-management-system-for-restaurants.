# Образец переменных окружения. Скопируйте в .env и при необходимости поправьте.
# Файл .env в репозиторий не попадает — в нём могут быть секреты.

# ─── PostgreSQL ───
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Логические базы сервисов создаются при первом запуске
CATALOG_DB=catalog_db
ORDER_DB=order_db
PAYMENT_DB=payment_db
DELIVERY_DB=delivery_db

# ─── Redis ───
REDIS_PORT=6379
REDIS_HOST=localhost

# ─── Kafka ───
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092

# ─── Keycloak (профиль auth) ───
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── Приложение ───
NODE_ENV=development
LOG_LEVEL=debug
