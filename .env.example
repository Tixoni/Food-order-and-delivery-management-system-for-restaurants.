# Образец переменных окружения. Скопируйте в .env и при необходимости поправьте.
# Порты намеренно нестандартные: 5432, 6379 и 9092 часто заняты
# локально установленными службами.
# Файл .env в репозиторий не попадает — в нём могут быть секреты.

# ─── PostgreSQL ───
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=15432
POSTGRES_HOST=localhost

# Логические базы сервисов создаются при первом запуске
CATALOG_DB=catalog_db
ORDER_DB=order_db
PAYMENT_DB=payment_db
DELIVERY_DB=delivery_db

# ─── Redis ───
REDIS_PORT=16379
REDIS_HOST=localhost

# ─── Kafka ───
KAFKA_PORT=19092
KAFKA_BROKERS=localhost:19092

# ─── Кэш и доставка событий (шаг 1.2) ───
# Срок жизни кэша меню — страховка на случай потери события;
# при изменении меню кэш сбрасывается сразу.
MENU_CACHE_TTL_SECONDS=2
# Частота проверки неотправленных событий. Прямо влияет на CAT-4:
# изменение стоп-листа отражается в выдаче не позднее пяти секунд.
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100

# ─── Keycloak: вход и роли (шаг 1.4) ───
KEYCLOAK_PORT=18080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Область провайдера входа. Адрес попадает в поле издателя выданного токена,
# поэтому у проверяющей стороны он должен совпадать с тем, по которому
# токен получали.
KEYCLOAK_ISSUER=http://localhost:18080/realms/food-delivery
AUTH_AUDIENCE=food-delivery-api
AUTH_CLIENT_ID=web
# Внутренний адрес провайдера для сервисов в контейнерах; на машине
# разработчика не нужен — совпадает с KEYCLOAK_ISSUER.
KEYCLOAK_INTERNAL_URL=
# Регистрация клиентов с подтверждением e-mail (AUTH-1): служебное
# приложение шлюза. Секрет — учебный, из файла области.
AUTH_ADMIN_CLIENT_ID=gateway-admin
AUTH_ADMIN_CLIENT_SECRET=gateway-admin-dev-secret
# Куда ведёт ссылка из письма после подтверждения
APP_PUBLIC_URL=http://localhost:5173
# Почтовый сервер-ловушка: веб-интерфейс с письмами и порт SMTP
MAILPIT_UI_PORT=18025
MAILPIT_SMTP_PORT=11025
# Работа без провайдера входа — только для разработки, когда Keycloak не поднят.
# В рабочем окружении означает систему без проверки прав.
AUTH_DISABLED=false

# ─── Заказы и сага (итерация 2) ───
# Платежи и доставка: http — настоящий сервис по внутреннему HTTP; stub — заглушка
# внутри сервиса заказов (для разработки без сервиса-участника).
PAYMENT_MODE=http
DELIVERY_MODE=stub
CATALOG_URL=http://localhost:13001
# Управляемый отказ заглушки платежей для проверки компенсаций (REL-5):
# authorize, capture, void или refund. Пусто — без отказов.
PAYMENT_STUB_FAIL_OPERATION=
# Сроки статусов, минуты (REL-6). Для демонстрации можно уменьшить.
ORDER_TIMEOUT_RESTAURANT_MIN=3
# Попытки шагов саги до отмены заказа; задержка повторов растёт от базовой.
SAGA_AUTHORIZE_ATTEMPTS=5
SAGA_CAPTURE_ATTEMPTS=5
SAGA_RETRY_BASE_MS=1000
# Размыкатель цепи для вызовов соседних сервисов
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_MS=10000

# ─── Платежи (итерация 2) ───
# Служебный токен внутреннего API платёжного сервиса: его знает только order.
PAYMENT_INTERNAL_TOKEN=payment-internal-dev-token
# Эмулятор платёжного провайдера (контракт ЮKassa) и учётные данные магазина
PROVIDER_URL=http://localhost:13010
PROVIDER_PORT=13010
PROVIDER_SHOP_ID=food-delivery-shop
PROVIDER_SECRET_KEY=test_provider_dev_secret
# Таймаут вызова провайдера и сверка незавершённых операций после сбоев
PROVIDER_TIMEOUT_MS=800
RECONCILE_INTERVAL_MS=10000
RECONCILE_AFTER_MS=30000

# ─── Сервисы ───
GATEWAY_PORT=13000
CATALOG_PORT=13001
ORDER_PORT=13002
PAYMENT_PORT=13003
DELIVERY_PORT=13004

# ─── Приложение ───
NODE_ENV=development
LOG_LEVEL=debug
