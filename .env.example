# Образец переменных окружения. Скопируйте в .env и при необходимости поправьте.
# Порты намеренно нестандартные: 5432, 6379 и 9092 часто заняты
# локально установленными службами.
# Файл .env в репозиторий не попадает — в нём могут быть секреты.

# ─── PostgreSQL ───
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=15432
POSTGRES_HOST=localhost

# Логические базы сервисов создаются при первом запуске
CATALOG_DB=catalog_db
ORDER_DB=order_db
PAYMENT_DB=payment_db
DELIVERY_DB=delivery_db

# ─── Redis ───
REDIS_PORT=16379
REDIS_HOST=localhost

# ─── Kafka ───
KAFKA_PORT=19092
KAFKA_BROKERS=localhost:19092

# ─── Keycloak (профиль auth) ───
KEYCLOAK_PORT=18080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── Сервисы ───
GATEWAY_PORT=13000
CATALOG_PORT=13001
ORDER_PORT=13002
PAYMENT_PORT=13003
DELIVERY_PORT=13004

# ─── Приложение ───
NODE_ENV=development
LOG_LEVEL=debug
