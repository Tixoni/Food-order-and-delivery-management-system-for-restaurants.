{
  "realm": "food-delivery",
  "displayName": "Доставка еды",
  "internationalizationEnabled": true,
  "supportedLocales": ["ru"],
  "defaultLocale": "ru",
  "localizationTexts": {
    "ru": {
      "confirmEmailAddressVerification": "Подтвердите, что адрес {0} принадлежит вам.",
      "proceedWithAction": "» Подтвердить"
    }
  },
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@food.local",
    "fromDisplayName": "Доставка еды",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "defaultRole": {
    "name": "default-roles-food-delivery",
    "description": "Роли, выдаваемые каждому новому пользователю",
    "composite": true,
    "composites": {
      "realm": ["offline_access", "uma_authorization", "client"]
    },
    "clientRole": false
  },
  "roles": {
    "realm": [
      {
        "name": "client",
        "description": "Клиент: заказывает еду"
      },
      {
        "name": "manager",
        "description": "Менеджер ресторана: меню, стоп-листы, зона доставки"
      },
      {
        "name": "kitchen",
        "description": "Кухня: очередь заказов и переводы статусов"
      },
      {
        "name": "courier",
        "description": "Курьер: смена, назначения, отметки доставки"
      },
      {
        "name": "operator",
        "description": "Оператор поддержки: поиск заказа, отмена"
      },
      {
        "name": "admin",
        "description": "Администратор: регистрация ресторанов и курьеров"
      },
      {
        "name": "default-roles-food-delivery",
        "description": "Роли, выдаваемые каждому новому пользователю. Состав задаётся здесь: из блока defaultRole провайдер его при загрузке не берёт",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization", "client"],
          "client": {
            "account": ["view-profile", "manage-account"]
          }
        },
        "clientRole": false
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "web",
      "name": "Веб-приложение",
      "description": "Единое приложение с разделами клиента, менеджера, кухни и курьера",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:13000/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": ["http://localhost:5173", "http://localhost:13000", "http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "food-delivery-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "restaurant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "restaurantId",
            "claim.name": "restaurantId",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "gateway-admin",
      "name": "Шлюз: регистрация клиентов",
      "description": "Служебное приложение шлюза. Только управление учётными записями: регистрация и письмо подтверждения e-mail (AUTH-1). Секрет здесь — учебный, в рабочем окружении выпускается заново.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "gateway-admin-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "client@food.local",
      "email": "client@food.local",
      "firstName": "Иван",
      "lastName": "Клиентов",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "client",
          "temporary": false
        }
      ],
      "realmRoles": ["client"]
    },
    {
      "username": "manager@food.local",
      "email": "manager@food.local",
      "firstName": "Мария",
      "lastName": "Менеджерова",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "manager",
          "temporary": false
        }
      ],
      "realmRoles": ["manager"],
      "attributes": {
        "restaurantId": [""]
      }
    },
    {
      "username": "kitchen@food.local",
      "email": "kitchen@food.local",
      "firstName": "Пётр",
      "lastName": "Поваров",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "kitchen",
          "temporary": false
        }
      ],
      "realmRoles": ["kitchen"],
      "attributes": {
        "restaurantId": [""]
      }
    },
    {
      "username": "courier@food.local",
      "email": "courier@food.local",
      "firstName": "Семён",
      "lastName": "Курьеров",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "courier",
          "temporary": false
        }
      ],
      "realmRoles": ["courier"]
    },
    {
      "username": "operator@food.local",
      "email": "operator@food.local",
      "firstName": "Ольга",
      "lastName": "Операторова",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "realmRoles": ["operator"]
    },
    {
      "username": "admin@food.local",
      "email": "admin@food.local",
      "firstName": "Алексей",
      "lastName": "Админов",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "service-account-gateway-admin",
      "enabled": true,
      "serviceAccountClientId": "gateway-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"restaurantId\", \"displayName\": \"Ресторан сотрудника\", \"validations\": {\"length\": {\"max\": 64}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"Сведения о сотруднике\"}]}"
          ]
        }
      }
    ]
  }
}
